---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import RiskMapController from "../components/dashboard/RiskMapController.jsx";
import CoolingWidget from "../components/dashboard/CoolingWidget.jsx";

// New React Components
import ServerConsumption from "../components/dashboard/ServerConsumption.jsx";
import ClimateMonitor from "../components/dashboard/ClimateMonitor.jsx";
import TariffMonitor from "../components/dashboard/TariffMonitor.jsx";
import EfficiencyRecommendations from "../components/dashboard/EfficiencyRecommendations.jsx";
import AlertFeed from "../components/dashboard/AlertFeed.jsx";
---

<DashboardLayout>
    <div class="dashboard-grid">
        <!-- TOP ROW: Key Monitors -->
        <div class="top-row">
            <div class="server-panel">
                <ServerConsumption client:load />
            </div>
            <div class="climate-panel">
                <ClimateMonitor client:load />
            </div>
            <div class="tariff-panel">
                <TariffMonitor client:load />
            </div>
        </div>

        <!-- MIDDLE ROW: Map & Operations -->
        <div class="middle-row">
            <div class="map-section">
                <RiskMapController client:only="react" />
            </div>
            <div class="alert-section">
                 <!-- Replaced Astro component with React component -->
                <div class="alert-wrapper">
                    <AlertFeed client:load />
                </div>
            </div>
        </div>

        <!-- BOTTOM ROW: Efficiency & Cooling -->
        <div class="bottom-row">
            <div class="efficiency-section">
                <EfficiencyRecommendations client:load />
            </div>
            <div class="cooling-section">
                <CoolingWidget client:visible />
            </div>
        </div>
    </div>
</DashboardLayout>

<style>
    .dashboard-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-bottom: 2rem;
    }

    /* Top Row Grid */
    .top-row {
        display: grid;
        grid-template-columns: 1.2fr 1fr 0.8fr;
        gap: 1.5rem;
        min-height: 280px;
    }

    /* Middle Row Grid */
    .middle-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 1.5rem;
        min-height: 400px;
    }

    .map-section {
        background: var(--bg-panel);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        overflow: hidden;
    }

    .alert-section {
        background: var(--bg-panel);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 1.5rem;
    }

    .alert-wrapper {
        height: 100%;
        overflow: hidden;
    }

    /* Bottom Row Grid */
    .bottom-row {
        display: grid;
        grid-template-columns: 2fr 1.5fr;
        gap: 1.5rem;
        min-height: 300px;
    }

    /* Responsive */
    @media (max-width: 1200px) {
        .top-row {
            grid-template-columns: 1fr 1fr;
        }
        .tariff-panel {
            grid-column: span 2;
        }
    }

    @media (max-width: 900px) {
        .top-row, .middle-row, .bottom-row {
            grid-template-columns: 1fr;
        }
        .tariff-panel {
            grid-column: span 1;
        }
    }
</style>
