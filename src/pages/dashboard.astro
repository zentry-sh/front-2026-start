---
import DashboardLayout from "../layouts/DashboardLayout.astro";
import StatCard from "../components/dashboard/StatCard.astro";
import RiskMap from "../components/dashboard/RiskMap.astro";
import AlertFeed from "../components/dashboard/AlertFeed.astro";
import CoolingSystemStatus from "../components/dashboard/CoolingSystemStatus.astro";
---

<DashboardLayout>
    <div class="dashboard-grid">
        <!-- Key Metrics Row -->
        <div class="metrics-row">
            <StatCard
                title="Uso Eficiente de Agua (WUE)"
                value="1.24"
                unit="L/kWh"
                trend="down"
                trendValue="0.03%"
                trendLabel="vs mes anterior"
                icon='<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>'
            />
            <StatCard
                title="Consumo Total Hoy"
                value="145.2"
                unit="m³"
                trend="up"
                trendValue="1.5%"
                trendLabel="vs promedio diario"
                icon='<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>'
            />
            <StatCard
                title="Nivel de Reserva"
                value="82"
                unit="%"
                trend="neutral"
                trendValue="0%"
                trendLabel="Estable"
                icon='<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"></path><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>'
            />
            <StatCard
                title="Calidad de Agua"
                value="98.5"
                unit="score"
                trend="up"
                trendValue="2pts"
                trendLabel="Mejorando"
                icon='<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>'
            />
        </div>

        <!-- Main Visuals Row -->
        <div class="visuals-row">
            <div class="map-section">
                <RiskMap />
            </div>
            <div class="feed-section">
                <AlertFeed />
            </div>
        </div>

        <!-- Operations Row -->
        <div class="ops-row">
            <div class="cooling-section">
                <CoolingSystemStatus />
            </div>
            <!-- Placeholder for future chart -->
            <div class="chart-placeholder">
                <h3>Predicción de Disponibilidad</h3>
                <div class="chart-visual">
                    <svg viewBox="0 0 500 150" class="chart-svg">
                        <polyline
                            points="0,100 50,90 100,95 150,70 200,65 250,55 300,50 350,60 400,40 450,20 500,30"
                            fill="none"
                            stroke="var(--acc-primary)"
                            stroke-width="3"></polyline>
                        <rect
                            x="0"
                            y="0"
                            width="100%"
                            height="100%"
                            fill="url(#gradient)"
                        />
                    </svg>
                    <div class="chart-labels">
                        <span>Hoy</span>
                        <span>+1 Sem</span>
                        <span>+2 Sem</span>
                        <span>+1 Mes</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</DashboardLayout>

<style>
    .dashboard-grid {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding-bottom: 2rem;
    }

    .metrics-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .visuals-row {
        display: grid;
        grid-template-columns: 2fr 1fr; /* Map takes more space */
        gap: 1.5rem;
        min-height: 400px;
    }

    .ops-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .chart-placeholder {
        background: var(--bg-panel);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 16px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
    }

    .chart-placeholder h3 {
        margin: 0 0 1.5rem 0;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .chart-visual {
        flex: 1;
        border-bottom: 1px solid var(--border-color);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    .chart-svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .chart-labels {
        display: flex;
        justify-content: space-between;
        margin-top: 0.5rem;
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    /* Responsive Adjustments */
    @media (max-width: 1200px) {
        .metrics-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 900px) {
        .visuals-row {
            grid-template-columns: 1fr;
        }
        .ops-row {
            grid-template-columns: 1fr;
        }
    }
</style>
